[flake8]
max-line-length = 97
extend-ignore = E203, E501, E701
exclude =
    build
# Stubs: black's stub style drops the blank lines between definitions
# (E301, E302, E305), and stubs refer to classes before they are defined, which
# pyflakes < 4.1 (the newest on Python 3.10) reports as F821. ruff checks F821
# in stubs correctly.
per-file-ignores =
    randomgen/tests/data/stable_hashes.py: E501
    *.pyi: E301, E302, E305, F821
