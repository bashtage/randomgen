from randomgen.common import BitGenerator
from randomgen.typing import IntegerSequenceSeed

class PCG32(BitGenerator):
    def __init__(
        self,
        seed: IntegerSequenceSeed | None = ...,
        inc: int | None = ...,
    ) -> None: ...
    def seed(
        self,
        seed: IntegerSequenceSeed | None = ...,
        inc: int | None = ...,
    ) -> None: ...
    @property
    def state(self) -> dict[str, str | dict[str, int]]: ...
    @state.setter
    def state(self, value: dict[str, str | dict[str, int]]) -> None: ...
    def advance(self, delta: int) -> PCG32: ...
    @staticmethod
    def advance_step(max_draws: int) -> int: ...
    def jumped(self, iter: int = ...) -> PCG32: ...
