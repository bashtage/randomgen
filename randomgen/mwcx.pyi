from typing_extensions import Self

from randomgen.common import BitGenerator
from randomgen.typing import IntegerSequenceSeed

class _MWCX(BitGenerator):
    def seed(self, seed: IntegerSequenceSeed | None = ...) -> None: ...
    def advance(self, delta: int) -> Self: ...
    def jumped(self, iter: int = ...) -> Self: ...
    @property
    def state(self) -> dict[str, str | int | dict[str, int]]: ...
    @state.setter
    def state(self, value: dict[str, str | int | dict[str, int]]) -> None: ...

class MWC192X(_MWCX):
    def __init__(self, seed: IntegerSequenceSeed | None = ...) -> None: ...

class MWC128X(_MWCX):
    def __init__(self, seed: IntegerSequenceSeed | None = ...) -> None: ...

class MWC128X32(_MWCX):
    def __init__(self, seed: IntegerSequenceSeed | None = ...) -> None: ...

class MWC64X32(_MWCX):
    def __init__(self, seed: IntegerSequenceSeed | None = ...) -> None: ...
